{"segments": [{"start_ms": 799, "duration_ms": 5080, "text": "フリーレン様朝でございます起きて"}, {"start_ms": 7720, "duration_ms": 4120, "text": "[音楽]"}, {"start_ms": 14639, "duration_ms": 4560, "text": "ください海岸の清掃に行きます"}, {"start_ms": 19440, "duration_ms": 11610, "text": "[音楽]"}, {"start_ms": 28960, "duration_ms": 10179, "text": "よ"}, {"start_ms": 31050, "duration_ms": 8089, "text": "[音楽]"}, {"start_ms": 41320, "duration_ms": 3640, "text": "う"}, {"start_ms": 42610, "duration_ms": 8190, "text": "[音楽]"}, {"start_ms": 44960, "duration_ms": 8599, "text": "寒いふと思ったのですが何フリーレン様て"}, {"start_ms": 50800, "duration_ms": 6160, "text": "もしかしてすごくだらしがない人なの"}, {"start_ms": 53559, "duration_ms": 7561, "text": "でしょうか毎朝フリーレン様のことを"}, {"start_ms": 56960, "duration_ms": 8440, "text": "起こしてご飯食べさせて服着せて"}, {"start_ms": 61120, "duration_ms": 8160, "text": "これ私完全にお母さんですよね1人でも"}, {"start_ms": 65400, "duration_ms": 9680, "text": "できるよでもそれだと昼まで寝ていますよ"}, {"start_ms": 69280, "duration_ms": 8440, "text": "ねうんま別に私はもう諦めていますけど"}, {"start_ms": 75080, "duration_ms": 2640, "text": "ごめん"}, {"start_ms": 85320, "duration_ms": 3000, "text": "て"}]}