{"segments": [{"start_ms": 3080, "duration_ms": 7400, "text": "かしアカデミー入学が決まったからって"}, {"start_ms": 6399, "duration_ms": 8601, "text": "うかうかしてられないよえこのまま行くと"}, {"start_ms": 10480, "duration_ms": 8799, "text": "あの子はお前より強くなるあいつ"}, {"start_ms": 15000, "duration_ms": 7760, "text": "が補欠の発表はまだだろアカデミーもバカ"}, {"start_ms": 19279, "duration_ms": 5080, "text": "じゃない彼の名前を聞いて覚えておくと"}, {"start_ms": 22760, "duration_ms": 6640, "text": "いい"}, {"start_ms": 24359, "duration_ms": 5041, "text": "えいいライバルになるよ"}, {"start_ms": 32759, "duration_ms": 2361, "text": "名前"}, {"start_ms": 38520, "duration_ms": 6600, "text": "はナトガこれから誰よりも強くなる男"}, {"start_ms": 45690, "duration_ms": 3150, "text": "[音楽]"}, {"start_ms": 53280, "duration_ms": 7759, "text": "だ今回ばかりはいい時に来てくれたよ"}, {"start_ms": 57719, "duration_ms": 8361, "text": "大丈夫かかし"}, {"start_ms": 61039, "duration_ms": 5041, "text": "本当に父さんの言った通りだったよ"}, {"start_ms": 70920, "duration_ms": 7960, "text": "かこのチャクラ認めてやろう体術において"}, {"start_ms": 75759, "duration_ms": 7841, "text": "俺の戦ったものでお前の右に出るものは"}, {"start_ms": 78880, "duration_ms": 8120, "text": "1人としておらんこのまだがお前を最強と"}, {"start_ms": 83600, "duration_ms": 3400, "text": "呼んでやる"}, {"start_ms": 94759, "duration_ms": 7360, "text": "早い何空間がねじ曲がっただ"}, {"start_ms": 99119, "duration_ms": 3000, "text": "と"}, {"start_ms": 112410, "duration_ms": 3079, "text": "[音楽]"}, {"start_ms": 115880, "duration_ms": 5120, "text": "やうわうわ"}, {"start_ms": 124840, "duration_ms": 8140, "text": "[音楽]"}, {"start_ms": 130400, "duration_ms": 6400, "text": "[拍手]"}, {"start_ms": 132980, "duration_ms": 6060, "text": "[音楽]"}, {"start_ms": 136800, "duration_ms": 9760, "text": "ガ"}, {"start_ms": 139040, "duration_ms": 7520, "text": "先生これはガの最後の技どうなった"}, {"start_ms": 160080, "duration_ms": 3000, "text": "あ"}]}