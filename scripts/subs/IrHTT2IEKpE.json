{"segments": [{"start_ms": 13679, "duration_ms": 6921, "text": "魔法系があんなに近づくからあを甘く見て"}, {"start_ms": 17320, "duration_ms": 9879, "text": "いたようだまともに食らってしまっ"}, {"start_ms": 20600, "duration_ms": 6599, "text": "たよやはりよでは"}, {"start_ms": 30190, "duration_ms": 6169, "text": "[音楽]"}, {"start_ms": 38820, "duration_ms": 3119, "text": "[音楽]"}, {"start_ms": 48239, "duration_ms": 6561, "text": "エクシハン"}, {"start_ms": 50520, "duration_ms": 7600, "text": "チェシャ彼は本当に魔法系なのか自分にも"}, {"start_ms": 54800, "duration_ms": 5599, "text": "分からなくなっていますよまさかここまで"}, {"start_ms": 58120, "duration_ms": 6959, "text": "とは"}, {"start_ms": 60399, "duration_ms": 4680, "text": "なかなか頑丈だな殻があるから"}, {"start_ms": 81000, "duration_ms": 6360, "text": "かなんて戦いだ永久の自分では立っている"}, {"start_ms": 85640, "duration_ms": 7560, "text": "のが"}, {"start_ms": 87360, "duration_ms": 5840, "text": "やっと魔力の流れだけで気を失いそう"}, {"start_ms": 95840, "duration_ms": 5480, "text": "だ私が押されているだ"}, {"start_ms": 110600, "duration_ms": 5159, "text": "となぜ"}, {"start_ms": 113240, "duration_ms": 8159, "text": "だこの"}, {"start_ms": 115759, "duration_ms": 5640, "text": "人間一体何者だ"}, {"start_ms": 137740, "duration_ms": 3310, "text": "[音楽]"}, {"start_ms": 145519, "duration_ms": 5080, "text": "これ"}, {"start_ms": 146400, "duration_ms": 8520, "text": "は周辺の海洋生物から取り込ん"}, {"start_ms": 150599, "duration_ms": 6640, "text": "私の力で練り上げた猛毒だもはや動くこと"}, {"start_ms": 154920, "duration_ms": 7679, "text": "もでき"}, {"start_ms": 157239, "duration_ms": 5360, "text": "まこれでお前はもう終わり"}, {"start_ms": 162760, "duration_ms": 5880, "text": "だ"}, {"start_ms": 164640, "duration_ms": 4000, "text": "人間死ぬ"}, {"start_ms": 186239, "duration_ms": 7920, "text": "毒を食らったのでは彼は無事だったのです"}, {"start_ms": 190159, "duration_ms": 7241, "text": "かもはや何が起きても不思議に思えん"}, {"start_ms": 194159, "duration_ms": 8440, "text": "な隠し玉があったわけ"}, {"start_ms": 197400, "duration_ms": 5199, "text": "ね通りで余裕が感じられると思っ"}, {"start_ms": 203120, "duration_ms": 7440, "text": "たでも感覚の力地が上がったからだろうか"}, {"start_ms": 207720, "duration_ms": 4239, "text": "奴の感情が読み取れる"}, {"start_ms": 210560, "duration_ms": 5239, "text": "焦りが"}, {"start_ms": 211959, "duration_ms": 5881, "text": "見えるそれはこちらも同じ"}, {"start_ms": 215799, "duration_ms": 5881, "text": "か一刻も"}, {"start_ms": 217840, "duration_ms": 3840, "text": "早く終わらせなけれ"}, {"start_ms": 230560, "duration_ms": 8280, "text": "ば毒は効かない力比べは"}, {"start_ms": 234840, "duration_ms": 4000, "text": "無ならば"}, {"start_ms": 239840, "duration_ms": 3000, "text": "う"}, {"start_ms": 253480, "duration_ms": 11530, "text": "[音楽]"}, {"start_ms": 280919, "duration_ms": 3000, "text": "う"}, {"start_ms": 292350, "duration_ms": 3120, "text": "[音楽]"}, {"start_ms": 311120, "duration_ms": 6120, "text": "私と引けをらない"}, {"start_ms": 313800, "duration_ms": 8800, "text": "スピードしかもどんどん早くなって"}, {"start_ms": 317240, "duration_ms": 5360, "text": "いるどうしてこんなことが"}, {"start_ms": 358880, "duration_ms": 4129, "text": "う"}, {"start_ms": 359740, "duration_ms": 3269, "text": "[音楽]"}, {"start_ms": 372570, "duration_ms": 8629, "text": "[音楽]"}, {"start_ms": 379199, "duration_ms": 3621, "text": "う"}, {"start_ms": 381199, "duration_ms": 4771, "text": "アップグレード"}, {"start_ms": 382820, "duration_ms": 3150, "text": "[音楽]"}, {"start_ms": 387880, "duration_ms": 3680, "text": "乱闘なんだ"}, {"start_ms": 398840, "duration_ms": 6359, "text": "マジ自由能力かななの"}, {"start_ms": 405840, "duration_ms": 5280, "text": "だなんなのだ今のは"}, {"start_ms": 433160, "duration_ms": 6800, "text": "なんなんだあの人間はあの"}, {"start_ms": 444080, "duration_ms": 4000, "text": "人間行け"}, {"start_ms": 448890, "duration_ms": 3160, "text": "[音楽]"}, {"start_ms": 470479, "duration_ms": 9361, "text": "なぜと私は誰よりも強く生まれた"}, {"start_ms": 476280, "duration_ms": 8639, "text": "はず全てを飲み込み"}, {"start_ms": 479840, "duration_ms": 8600, "text": "に向かって成長を続けるのが私私は王の"}, {"start_ms": 484919, "duration_ms": 3521, "text": "はずだそれなの"}, {"start_ms": 489400, "duration_ms": 7680, "text": "に"}, {"start_ms": 491199, "duration_ms": 8400, "text": "逃げ逃げなければ生きるために逃げなけれ"}, {"start_ms": 497080, "duration_ms": 2519, "text": "ばなら"}, {"start_ms": 501120, "duration_ms": 4840, "text": "ない少しでも遠"}, {"start_ms": 522880, "duration_ms": 5800, "text": "早く早く早く遠く"}, {"start_ms": 532450, "duration_ms": 3129, "text": "[音楽]"}, {"start_ms": 538800, "duration_ms": 3290, "text": "[音楽]"}, {"start_ms": 547280, "duration_ms": 10230, "text": "[音楽]"}, {"start_ms": 560440, "duration_ms": 5639, "text": "ありたちが逃げていった勝ったの"}, {"start_ms": 567279, "duration_ms": 5081, "text": "かソンハンターJA"}]}