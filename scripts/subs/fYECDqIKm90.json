{"segments": [{"start_ms": 8160, "duration_ms": 11920, "text": "エーラ流星でしたっけ50年に1度の流星"}, {"start_ms": 14480, "duration_ms": 5600, "text": "軍平和な時代の幕開けにはちょうどいい"}, {"start_ms": 20560, "duration_ms": 8400, "text": "な綺麗だな街中だと見えにくいね人が感動"}, {"start_ms": 26320, "duration_ms": 4560, "text": "しているんだ空気を読み"}, {"start_ms": 28960, "duration_ms": 3960, "text": "たまえ"}, {"start_ms": 30880, "duration_ms": 5960, "text": "じゃあ次"}, {"start_ms": 32920, "duration_ms": 6920, "text": "ん50年後もっと綺麗に見える場所知っ"}, {"start_ms": 36840, "duration_ms": 3000, "text": "てるから案内する"}, {"start_ms": 41120, "duration_ms": 10560, "text": "よ何いやなんでも"}, {"start_ms": 46399, "duration_ms": 5281, "text": "ないそうだなみんなで"}, {"start_ms": 58920, "duration_ms": 3000, "text": "見よう"}, {"start_ms": 68000, "duration_ms": 3000, "text": "DET"}]}